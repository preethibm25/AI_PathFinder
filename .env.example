# Backend Configuration
PROJECT_NAME="AI-Enabled Career Counselling & Family Decision-Support Platform"
API_V1_STR="/api"
SECRET_KEY="super-secret-jwt-token-key-for-career-counselling-platform"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for local development, switch to PostgreSQL for production)
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/career_guidance
DATABASE_URL="sqlite:///./career_guidance.db"

# Recommendation Weights (Must sum to 1.0)
WEIGHT_INTEREST=0.30
WEIGHT_SKILL=0.20
WEIGHT_ACADEMIC=0.15
WEIGHT_APTITUDE=0.15
WEIGHT_STRENGTH=0.10
WEIGHT_PREFERENCE=0.10

# Optional LLM Provider Configuration (gemini / openai / template)
LLM_PROVIDER="template"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
